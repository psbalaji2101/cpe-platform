# Recommended: run python3 scripts/configure.py to generate private credentials.
# Manual setup: copy this file to .env and replace every placeholder password.
# Never commit .env. Use URL-safe database passwords (for example, hex secrets).
POSTGRES_PASSWORD=replace-with-a-unique-32-character-secret
CPE_RUNTIME_PASSWORD=replace-with-a-different-unique-32-character-secret
CPE_ADMIN_EMAIL=admin@cpe.local
CPE_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-chars

# Local web deployment. Set secure cookies to true when serving over HTTPS.
CPE_PORT=8097
CPE_ORIGIN=http://localhost:8097
CPE_SECURE_COOKIES=false
CPE_RECOVERY_DAYS=7

# Mock works without a model service. To use your approved service, set
# CPE_LLM_PROVIDER=compatible and fill in the URL, model, hosts, and API key.
CPE_LLM_PROVIDER=mock
CPE_LLM_BASE_URL=
CPE_LLM_MODEL=
CPE_LLM_ALLOWED_HOSTS=
CPE_LLM_API_KEY=
CPE_LLM_ALLOW_HTTP=false

# Additional backend settings require a Compose environment override.
# See docs/CONFIGURATION.md for limits, OIDC, and mounted API-key files.
